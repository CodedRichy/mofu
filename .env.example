# ======================
# Required
# ======================

DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_client_id

# ======================
# AI Providers
# ======================

# Groq — used for AI features
GROQ_API_KEY=your_groq_api_key

# OpenAI — optional, alternative AI provider
OPENAI_API_KEY=your_openai_api_key

# ======================
# Database (optional for dev — bot runs without these)
# ======================

DATABASE_URL=postgresql://user:password@localhost:5432/sonder
REDIS_URL=redis://localhost:6379

# ======================
# Last.fm (optional — needed for music profile commands)
# Get a key at https://www.last.fm/api/account/create
# ======================

LASTFM_API_KEY=your_lastfm_api_key

# ======================
# Web Dashboard (optional)
# ======================

DASHBOARD_PORT=3001
SESSION_SECRET=random_secret_here
DASHBOARD_CALLBACK_URL=http://localhost:3000/auth/callback
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ======================
# Logging
# ======================

# Options: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Production: register slash commands globally (default is per-guild for instant dev updates)
# REGISTER_GLOBAL=1

# Optional: channel that gets a "what changed" post when the bot starts on a new commit
UPDATE_CHANNEL_ID=

# ======================
# Web (Vite) - lives in web/, read at build/dev time
# ======================

# Your Discord application's client ID (same value as DISCORD_CLIENT_ID above). The website uses it for the
# "Add to Discord" invite link and the Login/OAuth links. Unset = the invite button is disabled (dev warning shown).
# Copy to web/.env as well; Vite only exposes VITE_-prefixed variables.
VITE_DISCORD_CLIENT_ID=
